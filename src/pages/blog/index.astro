---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const sorted = posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Writing — closedai.in" description="Writing on AI security, data infrastructure, and building things that don't break.">

  <section class="page-hero">
    <p class="eyebrow">All posts</p>
    <h1>Writing<span class="period">.</span></h1>
    <p class="sub">
      On AI security, data infrastructure, and building things that don't break.
    </p>
  </section>

  <section class="post-section">
    <PostList posts={sorted} />
  </section>

</Base>

<style>
  .page-hero {
    text-align: center;
    padding: 64px var(--space-page) 56px;
    border-bottom: var(--border);
  }

  .eyebrow {
    font-size: var(--font-size-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 16px;
  }

  h1 {
    font-size: var(--font-size-hero);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.0;
    margin-bottom: 16px;
  }

  .period {
    color: var(--color-accent);
  }

  .sub {
    font-size: var(--font-size-base);
    color: var(--color-ink-muted);
    max-width: 420px;
    margin: 0 auto;
  }

  .post-section {
    padding: var(--space-section) var(--space-page);
  }
</style>
