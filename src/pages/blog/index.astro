---
import Base from '../../layouts/Base.astro';
import IndexHeader from '../../components/IndexHeader.astro';
import WritingList from '../../components/WritingList.astro';
import { getCollection } from 'astro:content';
import { publishedPosts } from '../../utils/content';

const posts = publishedPosts(await getCollection('blog'));
const topics = [...new Set(posts.flatMap((post) => post.data.topics))].sort();
---

<Base title="Writing — Swapnil Nair" description="Writing by Swapnil Nair on technology, business, markets, systems, and other interests.">
  <IndexHeader title="Writing" description="Notes from building and breaking production systems, plus the occasional detour into history, machines and arguments." />
  <nav class="topics" aria-label="Writing topics">
    <a href="/blog" aria-current="page">All</a>
    {topics.map((topic) => <a href={`/blog/topics/${encodeURIComponent(topic.toLowerCase().replaceAll(' ', '-'))}`}>{topic}</a>)}
  </nav>
  <WritingList posts={posts} />
</Base>
<style>
  .topics { display: flex; flex-wrap: wrap; gap: 8px; padding: 20px var(--space-page); border-bottom: var(--border-faint); }
  .topics a { border: 1px solid #2a2c2f; padding: 7px 12px; font-size: 14px; color: var(--color-ink-muted); }
  .topics a:hover, .topics a[aria-current] { color: var(--color-ink); border-color: var(--color-border-strong); }

  @media screen and (min-width: 1001px) {
    .topics { padding-block: 18px; }
    .topics a { padding: 6px 11px; font-size: 13px; }
  }
</style>
