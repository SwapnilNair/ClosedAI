---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((item) => ({ params: { slug: item.data.slug }, props: { item } }));
}

const { item } = Astro.props;
const { Content, headings } = await render(item);
---

<Base title={`${item.data.title} — Selected work`} description={item.data.summary}>
  <article>
    <header class="case-head">
      <a class="mono-label" href="/work">← Case index</a>
      <div class="case-code"><span>CASE · {item.data.order.toString().padStart(2, '0')}</span><span class="status">{item.data.status}</span></div>
      <h1>{item.data.title}</h1>
      <p>{item.data.summary}</p>
      <div class="case-ledger">
        <div><span>Role</span><strong>{item.data.role}</strong></div>
        <div><span>Period</span><strong>{item.data.year}</strong></div>
        <div><span>Domains</span><strong>{item.data.domains.join(' · ')}</strong></div>
        <div><span>Status</span><strong>{item.data.status}</strong></div>
      </div>
    </header>

    <section class="case-body">
      <aside>
        <span class="mono-label">Case contents</span>
        <nav>{headings.filter((heading) => heading.depth === 2).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav>
      </aside>
      <div class="prose"><Content /></div>
      <aside class="evidence-panel">
        <span class="mono-label accent">Evidence</span>
        <ul>{item.data.evidence.map((point) => <li>{point}</li>)}</ul>
        <span class="mono-label stack-title">Stack</span>
        <div class="stack">{item.data.stack.map((entry) => <span>{entry}</span>)}</div>
        {item.data.externalUrl && <a class="external" href={item.data.externalUrl} target="_blank" rel="noopener noreferrer">Public project ↗</a>}
      </aside>
    </section>
  </article>
</Base>

<style>
  .case-head { padding: 72px max(var(--space-page), calc((100% - 1050px) / 2)) 58px; border-bottom: var(--border-faint); }
  .case-code { display: flex; justify-content: space-between; margin-top: 58px; font-family: var(--font-mono); font-size: 10px; letter-spacing: .1em; color: var(--color-ink-faint); }
  .status { color: var(--color-accent); }
  h1 { margin-top: 22px; font-size: var(--font-size-hero); line-height: 1; letter-spacing: -.04em; }
  .case-head > p { max-width: 780px; margin-top: 24px; font-size: 20px; color: var(--color-ink-muted); }
  .case-ledger { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 50px; border-top: var(--border-faint); }
  .case-ledger div { padding: 14px 10px 14px 0; border-bottom: var(--border-faint); }
  .case-ledger span, .case-ledger strong { display: block; font-family: var(--font-mono); font-size: 9px; }
  .case-ledger span { text-transform: uppercase; color: var(--color-ink-faint); }
  .case-ledger strong { margin-top: 6px; font-weight: 400; }
  .case-body { display: grid; grid-template-columns: 170px minmax(0, var(--reading-width)) 210px; justify-content: center; gap: 52px; padding: 76px var(--space-page) 100px; }
  aside { height: fit-content; position: sticky; top: 24px; }
  aside nav { display: flex; flex-direction: column; gap: 10px; margin-top: 16px; }
  aside nav a { font-size: 12px; color: var(--color-ink-faint); }
  aside nav a:hover { color: var(--color-accent); }
  .prose { font-size: 17px; line-height: 1.82; color: #c5c5ca; }
  .prose :global(p) { margin-bottom: 24px; }
  .prose :global(h2) { margin: 54px 0 18px; padding-top: 18px; border-top: var(--border); font-size: 29px; color: var(--color-ink); }
  .prose :global(h2:first-child) { margin-top: 0; }
  .evidence-panel { padding: 20px; border: var(--border); background: var(--color-surface); }
  .evidence-panel ul { margin: 16px 0 26px; list-style: none; }
  .evidence-panel li { padding: 9px 0; border-bottom: var(--border-faint); font-size: 12px; color: var(--color-ink-muted); }
  .evidence-panel li::before { content: '↳ '; color: var(--color-accent); }
  .stack-title { display: block; margin-top: 8px; }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .stack span { padding: 4px 7px; border: var(--border-faint); font-family: var(--font-mono); font-size: 9px; color: var(--color-ink-muted); }
  .external { display: block; margin-top: 24px; font-family: var(--font-mono); font-size: 9px; color: var(--color-accent); }
  @media (max-width: 1120px) { .case-body { grid-template-columns: minmax(0, var(--reading-width)); } aside { position: static; } .case-body > aside:first-child { display: none; } .evidence-panel { order: -1; } }
  @media (max-width: 700px) { .case-ledger { grid-template-columns: 1fr 1fr; } }

  @media screen and (min-width: 1001px) {
    .case-head { padding-top: 63px; padding-bottom: 51px; }
    .case-code { margin-top: 51px; }
    .case-head > p { margin-top: 21px; font-size: 18px; }
    .case-body { padding-block: 67px 88px; gap: 45px; }
    .prose { font-size: 16px; }
    .prose :global(h2) { margin-top: 47px; font-size: 26px; }
  }
</style>
