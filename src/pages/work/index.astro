---
import Base from '../../layouts/Base.astro';
import IndexHeader from '../../components/IndexHeader.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getCollection } from 'astro:content';
import { projects } from '../../data/projects';
const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Selected work — Swapnil Nair" description="Selected work across AI security, systems engineering, and Mac apps.">
  <IndexHeader wideIntro title="Work" description="From AI security and production systems to Mac apps built for everyday use and a little fun. Things I’ve built, the decisions behind them, and what you can try." />
  <section class="work-wrap">
    <div class="work-grid">
      {projects.map((project, index) => <WorkCard item={{ data: project }} index={index} href={`/${project.slug}`} />)}
      {work.map((item, index) => <WorkCard item={item} index={index + projects.length} />)}
    </div>
  </section>
</Base>

<style>
  .work-wrap { padding: 40px var(--space-page) var(--space-section); }
  .work-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  @media (max-width: 700px) {
    .work-wrap { padding-top: 24px; }
    .work-grid { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
