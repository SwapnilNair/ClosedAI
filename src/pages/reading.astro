---
import Base from '../layouts/Base.astro';
import IndexHeader from '../components/IndexHeader.astro';
import { z } from 'astro/zod';
import { frontmatter as reading } from '../data/reading.md';

const books = z.array(z.object({
  title: z.string().trim().min(1),
  author: z.string().trim().min(1),
  note: z.string().trim().optional(),
  url: z.url().refine((value) => ['https:', 'http:'].includes(new URL(value).protocol)).optional(),
})).parse(reading.books);
---
<Base title="Reading — Swapnil Nair" description="Books and personal reading notes from Swapnil Nair.">
  <IndexHeader title="Reading" description="Books I’ve read, with a few personal notes. I’ll keep adding to this list." />
  <section class="reading-list" aria-label="Reading list">
    {books.length > 0 ? <ul>
      {books.map((book) => <li class:list={["book", { "without-note": !book.note }]}>
        <div class="book-details">
          <h2>{book.url ? <a href={book.url} target="_blank" rel="noopener noreferrer">{book.title} <span aria-hidden="true">↗</span></a> : book.title}</h2>
          <p class="author">{book.author}</p>
        </div>
        {book.note && <p class="note">{book.note}</p>}
      </li>)}
    </ul> : <p class="empty">Book recommendations coming soon.</p>}
  </section>
</Base>
<style>
  .reading-list { padding: 16px var(--space-page) var(--space-section); }
  ul { list-style: none; }
  .book { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); gap: 64px; padding: 36px 0; border-bottom: var(--border-faint); align-items: start; }
  .book.without-note { grid-template-columns: 1fr; }
  h2 { font-size: 24px; line-height: 1.3; letter-spacing: -.015em; font-weight: 400; }
  h2 span { font-size: 16px; color: var(--color-ink-faint); }
  a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .author { margin-top: 8px; font-size: 14px; color: var(--color-ink-faint); }
  .note { font-size: 17px; line-height: 1.7; color: var(--color-ink-muted); white-space: pre-line; overflow-wrap: anywhere; }
  .empty { padding: 40px 0; font-size: 16px; color: var(--color-ink-muted); }
  @media (max-width: 700px) {
    .book { grid-template-columns: 1fr; gap: 18px; padding-block: 28px; }
    h2 { font-size: 21px; }
    .note { font-size: 16px; }
  }
  @media screen and (min-width: 1001px) {
    .book { gap: 56px; padding-block: 32px; }
    h2 { font-size: 21px; }
  }
</style>
