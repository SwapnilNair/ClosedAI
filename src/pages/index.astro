---
import Base from '../layouts/Base.astro';
import ProfileHero from '../components/ProfileHero.astro';
import { getCollection } from 'astro:content';
import { publishedPosts, formatDate } from '../utils/content';
const posts = publishedPosts(await getCollection('blog')).slice(0, 3);
---
<Base>
  <ProfileHero />
  <section class="question">
    <div class="reading-column">
      <h2>Today’s question</h2>
      <p class="question-text">The Wright brothers couldn’t find a light enough engine for the 1903 Flyer, so their bicycle-shop mechanic built one in six weeks. Who was he?</p>
      <details><summary><span class="show">Show answer</span><span class="hide">Hide answer</span></summary><p class="answer"><strong>Charlie Taylor.</strong> He machined a 12 hp, four-cylinder aluminium-block engine with no drawings, mostly from the brothers’ rough sketches. He is often called the first aviation mechanic.</p></details>
    </div>
  </section>
  <section class="writing">
    <div class="reading-column writing-inner">
      <h2>Writing</h2><a class="all-writing" href="/blog">All writing →</a>
      <div class="posts">
        {posts.map((post) => <a class="post" href={`/blog/${post.id}`}><span>{post.data.title}</span><span class="post-meta">{post.data.topics[0]} · {formatDate(post.data.publishedAt, true)}</span></a>)}
      </div>
    </div>
  </section>
</Base>
<style>
  .reading-column { max-width: 760px; margin: 0 auto; }
  .question { padding: 88px var(--space-page); border-top: var(--border-faint); border-bottom: var(--border-faint); }
  .question .reading-column { display: flex; flex-direction: column; gap: 24px; }
  .question h2 { font-size: 17px; color: var(--color-ink-faint); }
  .question-text { font-size: 34px; line-height: 1.25; letter-spacing: -.02em; text-wrap: pretty; }
  summary { display: inline-block; cursor: pointer; list-style: none; font-size: 15px; border: var(--border); padding: 12px 18px; }
  summary::-webkit-details-marker { display: none; }
  .hide, details[open] .show { display: none; }
  details[open] .hide { display: inline; }
  .answer { padding-top: 18px; font-size: 18px; line-height: 1.6; color: #c8cac6; }
  .answer strong { color: var(--color-ink); }
  .writing { padding: 80px var(--space-page) 88px; }
  .writing-inner { display: grid; grid-template-columns: 1fr auto; gap: 20px; align-items: baseline; }
  .writing h2 { font-size: 30px; letter-spacing: -.02em; }
  .all-writing { font-size: 15px; color: var(--color-ink-muted); }
  .posts { grid-column: 1 / -1; }
  .post { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 24px; padding: 20px 0; border-top: 1px solid #1e2022; align-items: baseline; font-size: 20px; line-height: 1.35; }
  .post:hover, .all-writing:hover { opacity: .75; }
  .post-meta { font-size: 14px; color: var(--color-ink-faint); white-space: nowrap; }
  @media (max-width: 640px) {
    .question { padding: 44px 20px; }
    .question .reading-column { gap: 18px; }
    .question h2 { font-size: 15px; }
    .question-text { font-size: 22px; line-height: 1.32; letter-spacing: -.01em; }
    summary { display: block; text-align: center; padding: 14px 0; }
    .answer { font-size: 16px; padding-top: 16px; }
    .writing { padding: 44px 20px 32px; }
    .writing-inner { grid-template-columns: 1fr; gap: 14px; }
    .writing h2 { font-size: 24px; }
    .all-writing { grid-row: 3; padding: 10px 0; }
    .post { display: flex; flex-direction: column; gap: 4px; padding: 16px 0; font-size: 17px; }
    .post-meta { font-size: 13px; white-space: normal; }
  }

  @media screen and (min-width: 1001px) {
    .question { padding-block: 76px; }
    .question .reading-column { gap: 21px; }
    .question h2 { font-size: 15px; }
    .question-text { font-size: 30px; }
    summary { padding: 10px 16px; font-size: 14px; }
    .answer { font-size: 16px; padding-top: 16px; }
    .writing { padding-block: 70px 76px; }
    .writing h2 { font-size: 27px; }
    .post { padding-block: 18px; gap: 21px; font-size: 18px; }
  }
</style>
