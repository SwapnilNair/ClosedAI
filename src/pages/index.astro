---
import Base from '../layouts/Base.astro';
import StatBar from '../components/StatBar.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const allWork = await getCollection('work');
const recentWork = allWork.slice(0, 4);
---

<Base title="ClosedAI">

  <!-- Hero -->
  <section class="hero">
    <!--<p class="eyebrow">Software engineer · Data &amp; AI Security</p>-->
    <h1>Swapnil Nair<span class="period">.</span></h1>
   <p class="role">Helping secure AI Workloads at scale</p>
	    <div class="hero-photo-wrap">
      <img src="/hero.png" alt="Swapnil Nair" class="hero-photo" />
    </div>
 
    <p class="bio">
     I build things from scratch and study everything else. I move fast, read obsessively, form strong opinions, and write here when something is interesting enough to be worth the time. That bar is higher than it sounds.
        <div class="ctas">
      <a href="/blog" class="cta-primary">Read the blog</a>
      <a href="/work" class="cta-secondary">See my work →</a>
    </div>

  </section>

  <!-- In a sentence -->
    <!-- <section class="sentence-strip">
    <span class="sentence-label">In a sentence</span>
    <p class="sentence-text">
      I care about building things that <em><span class="accent">actually work</span></em> — and
      making sure nobody can quietly break them from the inside.
    </p>
  </section>-->

  <!-- Stat bar -->
    <!-- <StatBar /> -->

  <!-- Writing -->
  <section class="content-section">
    <div class="section-header">
      <span class="section-num">01</span>
      <span class="section-title">Writing</span>
    </div>
    <PostList posts={recentPosts} />
    <a href="/blog" class="view-all">All posts →</a>
  </section>

  <!-- Selected Work -->
  <section class="content-section">
    <div class="section-header">
      <span class="section-num">02</span>
      <span class="section-title">Selected Work</span>
    </div>
    <div class="work-grid">
      {recentWork.map(item => (
        <div class="work-card">
          <span class="work-status">{item.data.status}</span>
          <h3 class="work-title">{item.data.title}</h3>
          <p class="work-desc">{item.data.description}</p>
        </div>
      ))}
    </div>
  </section>

</Base>

<style>
  /* Hero */
  .hero {
    text-align: center;
    padding: 72px var(--space-page) 0;
    border-bottom: var(--border);
    overflow: hidden;
  }

  .eyebrow {
    font-size: var(--font-size-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 20px;
  }

  h1 {
    font-size: var(--font-size-hero);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.0;
    margin-bottom: 16px;
  }

  .period {
    color: var(--color-accent);
  }

  .role {
    font-size: var(--font-size-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    margin-bottom: 20px;
  }

  .bio-short {
    font-size: var(--font-size-xs);
    letter-spacing: 0.06em;
    color: var(--color-ink-faint);
    margin: 12px auto 28px;
    max-width: 420px;
  }

  .bio {
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
    max-width: 460px;
    margin: 32px auto 48px;
    line-height: 1.75;
  }

  .ctas {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 48px;
  }

  .cta-primary {
    background: var(--color-ink);
    color: var(--color-bg);
    padding: 13px 28px;
    font-size: var(--font-size-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cta-secondary {
    color: var(--color-ink-faint);
    border-bottom: var(--border);
    padding-bottom: 2px;
    font-size: var(--font-size-sm);
  }

  .hero-photo-wrap {
    display: flex;
    justify-content: center;
  }

  .hero-photo {
    width: min(340px, 72%);
    display: block;
    margin: 0 auto;
  }

  /* In a sentence */
  .sentence-strip {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 64px;
    padding: 48px var(--space-page);
    border-bottom: var(--border);
    align-items: center;
  }

  .sentence-label {
    font-size: var(--font-size-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .sentence-text {
    font-size: var(--font-size-lg);
    line-height: 1.6;
    color: var(--color-ink);
  }

  .sentence-text em {
    font-style: italic;
  }

  .accent {
    color: var(--color-accent);
  }

  /* Content sections */
  .content-section {
    padding: var(--space-section) var(--space-page);
    border-bottom: var(--border);
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 36px;
  }

  .section-num {
    font-size: var(--font-size-xs);
    letter-spacing: 0.16em;
    color: var(--color-accent);
  }

  .section-title {
    font-size: var(--font-size-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .view-all {
    display: inline-block;
    margin-top: 28px;
    font-size: var(--font-size-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    border-bottom: var(--border);
    padding-bottom: 2px;
  }

  /* Work grid */
  .work-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--color-border);
  }

  .work-card {
    background: var(--color-bg);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .work-card:hover {
    background: var(--color-hover);
  }

  .work-status {
    font-size: var(--font-size-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .work-title {
    font-size: var(--font-size-md);
    font-weight: 500;
    color: var(--color-ink);
  }

  .work-desc {
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
    line-height: 1.6;
  }

  /* ── Mobile ── */
  @media (max-width: 640px) {
    .hero {
      padding-top: 48px;
    }

    .ctas {
      flex-direction: column;
      align-items: center;
      gap: 20px;
    }

    .cta-primary {
      width: 100%;
      text-align: center;
    }

    .sentence-strip {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 32px var(--space-page);
    }

    .sentence-text {
      font-size: var(--font-size-md);
    }

    .work-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Tablet ── */
  @media (min-width: 641px) and (max-width: 900px) {
    .sentence-strip {
      gap: 32px;
    }
  }
</style>
