---
import Base from '../layouts/Base.astro';
import IndexHeader from '../components/IndexHeader.astro';

const sections = [
  {
    num: '01',
    title: 'Hardware',
    items: [
      { name: 'M4 MacBook Air · 16GB', desc: 'Primary machine. Upgraded from an 8GB M2 MacBook Pro, and it feels so much faster.' },
      { name: 'Dell XPS 13"', desc: 'Secondary machine. Use it when I have to deal with eBPF and amd64 specific builds.' },
      { name: 'LG 24" 2K Monitor (shared)', desc: 'Single external display. Anything more feels like context-switching overhead.' },
      { name: 'Airpods 4', desc: 'Light weight, don\'t clog up my ears and great sound quality.' },
      { name: 'No external keyboard', desc: 'Cannot deal with the clickety-clacking' },
      { name: 'No external mouse', desc: 'Never got used to an external mouse since my Thinkpad days (loved the red nubbin)' },
    ],
  },
  {
    num: '02',
    title: 'Apps & Tools',
    items: [
      { name: 'Cursor (without Pro)', desc: 'Primary editor. Just liked the Cursor Dark theme' },
      { name: 'Warp', desc: 'My terminal.' },
      { name: 'Maccy', desc: 'Clipboard history, always within reach.' },
      { name: 'k9s + kubectx', desc: 'Session management. One terminal, infinite kubernetes clusters.' },
      { name: 'TablePlus', desc: 'Actually amazing when you have to deal with a lot of databases like me.' },
    ],
  },
  {
    num: '03',
    title: 'Stack',
    items: [
      { name: 'Go', desc: 'Primary language for work, anything that needs to be fast and deployed.' },
      { name: 'C', desc: 'For lower-level systems work.' },
      { name: 'Python', desc: 'Tertiary language for data work, ML pipelines, and security tooling.' },
      { name: 'TypeScript', desc: 'Frontend when it\'s unavoidable. Type safety or nothing.' },
      { name: 'Mac-native containers', desc: 'Local development environments. Replaced Docker in my setup.' },
    ],
  },

];
---

<Base title="Uses — closedai.in" description="The hardware, software, and tools I use day to day.">

  <IndexHeader title="Uses" description="The hardware, software, and tools I use day to day. None of these are paid endorsements." />

  {sections.map(section => (
    <section class="uses-section">
      <div class="section-header">
        <span class="section-num">{section.num}</span>
        <span class="section-title">{section.title}</span>
      </div>
      <ul class="items">
        {section.items.map(item => (
          <li class="item">
            <span class="item-name">{item.name}</span>
            <span class="item-desc">{item.desc}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}

</Base>

<style>
  .uses-section {
    padding: var(--space-section) var(--space-page);
    border-bottom: var(--border);
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 36px;
  }

  .section-num {
    font-size: var(--font-size-xs);
    letter-spacing: 0.16em;
    color: var(--color-accent);
  }

  .section-title {
    font-size: var(--font-size-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }

  .items {
    display: flex;
    flex-direction: column;
  }

  .item {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 32px;
    padding: 16px 0;
    border-top: var(--border-faint);
    align-items: baseline;
  }

  .item:last-child {
    border-bottom: var(--border-faint);
  }

  .item-name {
    font-size: var(--font-size-base);
    font-weight: 500;
    color: var(--color-ink);
  }

  .item-desc {
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
    line-height: 1.6;
  }
</style>
