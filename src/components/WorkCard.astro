---
import type { CollectionEntry } from 'astro:content';
interface Props { item: CollectionEntry<'work'>; index?: number; }
const { item, index = 0 } = Astro.props;
---
<a class="work-card" href={`/work/${item.data.slug}`}>
  <div class="card-heading">
    <span class="card-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    <h2>{item.data.title}</h2>
  </div>
  <p>{item.data.summary}</p>
  <div class="card-foot"><span>{item.data.year}</span><span aria-hidden="true">→</span></div>
</a>
<style>
  .work-card { padding: 28px; border: var(--border-faint); background: var(--color-bg); display: flex; flex-direction: column; transition: border-color 150ms ease, background 150ms ease; }
  .work-card:hover { border-color: var(--color-border-strong); background: var(--color-surface); }
  .card-heading { display: flex; align-items: baseline; gap: 16px; font-size: 24px; line-height: 1.25; font-weight: 400; letter-spacing: -.015em; }
  .card-number { flex-shrink: 0; font: inherit; color: var(--color-ink-faint); }
  h2 { font: inherit; letter-spacing: inherit; }
  p { margin-top: 18px; margin-bottom: 32px; font-size: 16px; line-height: 1.6; color: var(--color-ink-muted); }
  .card-foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-top: 16px; border-top: var(--border-faint); margin-top: auto; font-size: 13px; color: var(--color-ink-faint); }
  .card-foot > span:last-child { font-size: 18px; color: var(--color-ink-muted); }
  @media screen and (min-width: 1001px) {
    .work-card { padding: 26px; }
    .card-heading { font-size: 21px; }
    p { font-size: 14px; }
  }
  @media (max-width: 700px) {
    .work-card { padding: 22px; }
    .card-heading { gap: 12px; }
    .card-heading { font-size: 21px; }
    p { font-size: 15px; margin-bottom: 26px; }
  }
</style>
