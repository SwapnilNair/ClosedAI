---
const pathname = Astro.url.pathname;
const links = [{ href: '/work', label: 'Work' }, { href: '/blog', label: 'Writing' }, { href: '/curated', label: 'Curated' }, { href: '/reading', label: 'Reading' }];
const active = (href: string) => pathname === href || pathname.startsWith(href + '/');
---
<header class="nav-shell">
  <a href="/" class="name" aria-label="Swapnil Nair, home">Swapnil Nair</a>
  <nav class="desktop-nav" aria-label="Primary navigation">
    {links.map((link) => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}
  </nav>
  <details class="mobile-menu">
    <summary>Menu</summary>
    <nav aria-label="Mobile navigation">
      {links.map((link) => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}
    </nav>
  </details>
</header>
<style>
  .nav-shell { height: 72px; padding: 0 var(--space-page); display: flex; align-items: center; justify-content: space-between; border-bottom: var(--border-faint); position: relative; z-index: 10; }
  .name { font-size: 17px; font-weight: 600; letter-spacing: -.01em; white-space: nowrap; }
  .desktop-nav { display: flex; gap: 32px; align-items: center; font-size: 15px; color: var(--color-ink-muted); }
  a:hover, a[aria-current] { color: var(--color-ink); }
  .mobile-menu { display: none; }
  @media (max-width: 800px) {
    .nav-shell { height: 60px; padding-inline: 20px; display: flex; }
    .name { font-size: 16px; }
    .desktop-nav { display: none; }
    .mobile-menu { display: block; font-size: 15px; }
    summary { list-style: none; cursor: pointer; padding: 12px 0 12px 12px; color: var(--color-ink-muted); }
    summary::-webkit-details-marker { display: none; }
    .mobile-menu nav { position: absolute; top: 59px; left: 0; right: 0; background: var(--color-bg); border-bottom: var(--border); padding: 12px 20px; display: grid; }
    .mobile-menu nav a { padding: 12px 0; }
  }

  @media screen and (min-width: 1001px) {
    .nav-shell { height: 64px; }
    .name { font-size: 15px; }
    .desktop-nav { gap: 28px; font-size: 14px; }
  }
</style>
